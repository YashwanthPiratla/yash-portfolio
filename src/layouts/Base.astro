---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Lightbox from '../components/Lightbox.astro';
import ScrollReveal from '../components/ScrollReveal.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;      // absolute or site-relative path
  type?: 'website' | 'article';
}
const SITE = 'https://yash.piratla.com';
const NAME = 'Yashwanth Piratla';
const {
  title,
  description = 'Engineering portfolio of Yashwanth Piratla — Mechanical Engineering student at UC Berkeley. Mechanical design, CAD, robotics, manufacturing, and hands-on engineering case studies.',
  ogImage = '/og-default.png',
  type = 'website',
} = Astro.props;
const fullTitle = title ? `${title} — ${NAME}` : `${NAME} — Mechanical Engineering, UC Berkeley`;
const canonical = new URL(Astro.url.pathname, SITE).href.replace(/\/$/, '') || SITE;
const og = ogImage.startsWith('http') ? ogImage : new URL(ogImage, SITE).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#101418" />
    <meta property="og:site_name" content={`${NAME} — Engineering Portfolio`} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org', '@type': 'Person', name: NAME, alternateName: 'Yash Piratla',
      url: SITE, email: 'mailto:ypiratla@gmail.com',
      sameAs: ['https://github.com/YashwanthPiratla', 'https://www.linkedin.com/in/yashwanth-piratla-5115b826a/'],
      affiliation: { '@type': 'CollegeOrUniversity', name: 'University of California, Berkeley' },
      jobTitle: 'Mechanical Engineering Student',
    })} />
  </head>
  <body>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <Lightbox />
    <ScrollReveal />
  </body>
</html>
