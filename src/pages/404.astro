---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found">
  <section class="section">
    <div class="wrap" style="text-align:center; padding: 4rem 0;">
      <span class="eyebrow accent">404</span>
      <h1>That page doesn't exist</h1>
      <p class="lede" style="margin: 1rem auto 2rem;">The link may be out of date. Try the
      engineering projects instead.</p>
      <div style="display:flex; gap:.6rem; justify-content:center; flex-wrap:wrap;">
        <a class="btn primary" href="/projects">Engineering Projects</a>
        <a class="btn" href="/">Home</a>
      </div>
    </div>
  </section>
</Base>
