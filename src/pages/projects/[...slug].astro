---
import { getCollection, render } from 'astro:content';
import CaseLayout from '../../components/CaseLayout.astro';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
  return projects.map((entry, i) => ({
    params: { slug: entry.id },
    props: {
      entry,
      prev: i > 0 ? projects[i - 1] : undefined,
      next: i < projects.length - 1 ? projects[i + 1] : undefined,
    },
  }));
}
const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---
<CaseLayout
  title={d.title}
  subtitle={d.subtitle}
  description={d.summary}
  eyebrow={d.season ?? 'Engineering project'}
  hero={d.hero}
  heroAlt={`${d.title} — project image`}
  heroContain={d.heroContain}
  stats={d.stats}
  sections={d.sections}
  prev={prev ? { href: `/projects/${prev.id}`, title: prev.data.title } : undefined}
  next={next ? { href: `/projects/${next.id}`, title: next.data.title } : undefined}
>
  <Content />
</CaseLayout>
