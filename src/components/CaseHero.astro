---
import { Image } from 'astro:assets';
import { img } from '../lib/images';
import Specs from './Specs.astro';
interface ResourceLink { label: string; url: string; primary?: boolean; }
interface Props {
  eyebrow?: string;
  title: string;
  subtitle: string;
  hero?: string;
  stats?: { value: string; label: string }[];
  resourceLinks?: ResourceLink[];
  contain?: boolean;
  heroAlt?: string;
  heroCaption?: string;
}
const {
  eyebrow, title, subtitle, hero, stats = [], resourceLinks = [], contain = false,
  heroAlt = '', heroCaption,
} = Astro.props;
const meta = hero ? img(hero) : undefined;
---
<section class="hero">
  <div class="wrap">
    {eyebrow && <span class="eyebrow accent">{eyebrow}</span>}
    <h1>{title}</h1>
    <p class="sub mono">{subtitle}</p>
    {resourceLinks.length > 0 && (
      <nav class="case-actions" aria-label="Project resources">
        {resourceLinks.map((resource) => (
          <a class:list={['btn', { primary: resource.primary }]} href={resource.url}
             target="_blank" rel="noopener noreferrer">
            {resource.label} ↗
          </a>
        ))}
      </nav>
    )}
    {meta && (
      <figure
        class:list={['fig', 'zoomable', 'shot', { contain }]}
        role="button"
        tabindex="0"
        aria-haspopup="dialog"
        aria-label={`Enlarge image: ${heroAlt}`}
      >
        <Image src={meta} alt={heroAlt} width={1600} loading="eager" format="webp" quality={84} />
        {heroCaption && <figcaption>{heroCaption}</figcaption>}
      </figure>
    )}
    {stats.length > 0 && <div class="statwrap"><Specs stats={stats} /></div>}
  </div>
</section>
<style>
  .hero { padding: clamp(2rem, 5vw, 3.5rem) 0 0; }
  h1 { margin: 0.4rem 0 0.5rem; }
  .sub { color: var(--ink-3); font-size: 0.9rem; letter-spacing: 0.02em; margin-bottom: 1.75rem; }
  .case-actions { display: flex; flex-wrap: wrap; gap: 0.65rem; margin: -0.6rem 0 1.5rem; }
  .shot { margin-bottom: 1.5rem; }
  .shot :global(img) { width: 100%; max-height: 70vh; object-fit: cover; object-position: center; }
  .shot.contain { background: #fff; }
  .shot.contain :global(img) { object-fit: contain; background: #fff; }
  .statwrap { margin-bottom: 0.5rem; }
</style>
