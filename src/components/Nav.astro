---
const links = [
  { href: '/', label: 'Home' },
  { href: '/projects', label: 'Engineering Projects' },
  { href: '/research', label: 'Research' },
  { href: '/resume', label: 'Resume' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (h: string) => h === '/' ? path === '/' : path.startsWith(h);
---
<header class="site">
  <a class="skip" href="#main">Skip to content</a>
  <div class="wrap bar">
    <a class="brand" href="/">
      <span class="name">Yashwanth Piratla</span>
      <span class="sub mono">MechE · UC Berkeley</span>
    </a>
    <nav aria-label="Primary">
      <button class="menu-btn" aria-expanded="false" aria-controls="primary-nav" aria-label="Menu">
        <span></span><span></span><span></span>
      </button>
      <ul id="primary-nav">
        {links.map(l => <li><a href={l.href} aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a></li>)}
        <li class="ext"><a href="https://github.com/YashwanthPiratla" target="_blank" rel="noopener">GitHub ↗</a></li>
        <li class="ext"><a href="https://www.linkedin.com/in/yashwanth-piratla-5115b826/" target="_blank" rel="noopener">LinkedIn ↗</a></li>
      </ul>
    </nav>
  </div>
</header>

<style>
  header.site { position: sticky; top: 0; z-index: 10; background: color-mix(in srgb, var(--bg) 94%, transparent); backdrop-filter: blur(10px); border-bottom: 1px solid var(--line); }
  .bar { height: 56px; display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .brand { display: flex; flex-direction: column; line-height: 1.1; }
  .brand .name { font-weight: 650; letter-spacing: -0.01em; }
  .brand .sub { font-size: 0.68rem; color: var(--ink-3); letter-spacing: 0.06em; }
  ul { list-style: none; margin: 0; padding: 0; display: flex; gap: 0.15rem; align-items: center; }
  li a { display: block; padding: 0.45rem 0.65rem; font-size: 0.9rem; color: var(--ink-2); border-radius: 3px; }
  li a:hover { color: var(--ink); background: var(--bg-2); }
  li a[aria-current="page"] { color: var(--ink); font-weight: 600; box-shadow: inset 0 -2px 0 var(--accent); border-radius: 0; }
  li.ext a { color: var(--ink-3); font-size: 0.85rem; }
  .menu-btn { display: none; background: none; border: 1px solid var(--line-2); border-radius: 3px; width: 40px; height: 34px; flex-direction: column; justify-content: center; gap: 4px; align-items: center; cursor: pointer; }
  .menu-btn span { display: block; width: 18px; height: 2px; background: var(--ink); }
  .skip { position: absolute; left: -999px; top: 0; background: var(--ink); color: var(--bg); padding: .5rem 1rem; }
  .skip:focus { left: 1rem; top: 1rem; z-index: 20; }
  @media (max-width: 900px) {
    .menu-btn { display: flex; }
    ul { display: none; position: absolute; left: 0; right: 0; top: 56px; flex-direction: column; align-items: stretch; background: var(--bg); border-bottom: 1px solid var(--line); padding: 0.5rem 1rem 1rem; gap: 0; }
    ul.open { display: flex; }
    li a { padding: 0.75rem 0.5rem; font-size: 1rem; }
    li.ext a { border-top: 1px solid var(--line); border-radius: 0; }
  }
</style>
<script>
  const btn = document.querySelector('.menu-btn');
  const list = document.getElementById('primary-nav');
  btn?.addEventListener('click', () => {
    const open = list!.classList.toggle('open');
    btn.setAttribute('aria-expanded', String(open));
  });
</script>
