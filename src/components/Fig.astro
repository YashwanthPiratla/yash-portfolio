---
/** Responsive, zoomable figure backed by an src/assets image. */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { src: ImageMetadata; alt: string; caption?: string; label?: string; contain?: boolean; width?: number; class?: string; loading?: 'lazy' | 'eager'; }
const { src, alt, caption, label, contain = false, width = 1200, class: cls = '', loading = 'lazy' } = Astro.props;
---
<figure class:list={['fig', 'zoomable', { contain }, cls]}>
  <Image src={src} alt={alt} width={width} loading={loading} format="webp" quality={82} />
  {(caption || label) && <figcaption>{label && <b>{label} · </b>}{caption}</figcaption>}
</figure>
